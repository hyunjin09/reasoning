# Root allowlist: new top-level payloads require deliberate review.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/code/
!/scripts/
!/tests/
!/infra/
!/plan/
!/reports/
!/workspace/
!/outputs/

# Environments, caches, secrets, old specs and live execution state stay local.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
uv_cache/
node_modules/
.env
.env.*
*.pem
*.key
*.log
*.tmp
*.tmp.py
*.swp
*.swo
.DS_Store
/piqd_agent_specs_v4/
/piqd_agent_sepcs_v4/
/fix_AGENTS.md
/ACCESS_POLICY.md
/infra/gpu_policy.md
/infra/gpu_scheduler.py
/workspace/env_state.md
/workspace/dataset_inventory.md
/runs/
/state/
/datasets/
/models/
/checkpoints/

# Never add model/tensor/data payloads via a broad add.
*.safetensors
*.pt
*.pth
*.ckpt
*.bin
*.npy
*.npz
*.parquet
*.arrow
*.whl
*.tar
*.tar.gz
*.zip
*.so

# Share all Markdown reports, including nested per-case reviews.
# Figures, binary artifacts and other report formats remain local.
/reports/**
!/reports/**/
!/reports/**/*.md

# Compact shared research state only. No vendor trees, caches or temp files.
/workspace/**
!/workspace/*.md
/workspace/env_state.md
!/workspace/phase_memory/
!/workspace/phase_memory/*.md
!/workspace/research_md_inventory_20261119.txt
!/workspace/research_history_20261119/
!/workspace/research_history_20261119/stages.tsv
!/workspace/research_history_20261119/source_manifest.json
!/workspace/research_history_20261119/validation.json

